#!/usr/bin/env bash
# Bootstrap dAImon on this machine: config, state dirs, TUI venv, agent hooks,
# management skills, then compile + generate plists. Pass --load to also load the
# launchd jobs (off by default so nothing starts before you've reviewed config).
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LOAD=0; WORKLOG=0
for arg in "$@"; do
  case "$arg" in
    --load) LOAD=1 ;;
    --worklog) WORKLOG=1 ;;
  esac
done

# Personal settings moved from ~/.config/daimon to ~/.daimon: move them first, so
# a fresh config is never created beside (and in front of) the legacy one.
python3 "$ROOT/lib/migrate.py" --personal-dir \
  || echo "warning: could not finish moving ~/.config/daimon to ~/.daimon — run 'daimon migrate'" >&2

CONFIG="$(python3 -c 'import sys; sys.path.insert(0, sys.argv[1]); import config; print(config.global_config_path())' "$ROOT/lib")"
if [ ! -f "$CONFIG" ]; then
  mkdir -p "$(dirname "$CONFIG")"
  cp "$ROOT/config/daimon.toml.example" "$CONFIG"
  echo "created $CONFIG — review it before scheduling (install continues)"
fi

eval "$(python3 "$ROOT/lib/config.py" paths)"
mkdir -p "$DAIMON_STATE_DIR/logs/transcripts" "$DAIMON_STATE_DIR/queues" "$DAIMON_STATE_DIR/runtime"
echo "state: $DAIMON_STATE_DIR"

if [ -f "$ROOT/tui/requirements.txt" ] && [ "${DAIMON_SKIP_TUI_VENV:-0}" != "1" ]; then
  python3 -m venv "$ROOT/tui/.venv"
  "$ROOT/tui/.venv/bin/pip" install -q -r "$ROOT/tui/requirements.txt" && echo "tui venv ready"
fi

python3 "$ROOT/lib/install_hooks.py" "$HOME/.claude/settings.json" "$ROOT/config/hooks/claude-hooks.json"

if [ "$WORKLOG" -eq 1 ]; then
  # Opt-in SessionEnd hook: logs the operator's own sessions to
  # ~/.claude/standup/worklog.jsonl for standup generation (daemon runs excluded).
  mkdir -p "$HOME/.claude/hooks"
  ln -sfn "$ROOT/hooks/standup-worklog.sh" "$HOME/.claude/hooks/standup-worklog.sh"
  python3 "$ROOT/lib/install_hooks.py" "$HOME/.claude/settings.json" "$ROOT/config/hooks/standup-worklog.json"
  echo "standup worklog hook installed (SessionEnd → ~/.claude/standup/worklog.jsonl)"
fi

mkdir -p "$HOME/.claude/skills"
for s in "$ROOT"/skills/*/; do
  name="$(basename "$s")"
  ln -sfn "$s" "$HOME/.claude/skills/$name"
done
echo "management skills linked into ~/.claude/skills"

mkdir -p "$HOME/.local/bin"
ln -sf "$ROOT/bin/daimon" "$HOME/.local/bin/daimon"
ln -sf "$ROOT/bin/daimonctl" "$HOME/.local/bin/daimonctl"
echo "linked daimon + daimonctl into ~/.local/bin (ensure it is on your PATH)"

# Personal settings live in ~/.daimon, not the repo: move any legacy
# daemon.local.toml / profile.local.toml there (idempotent; a no-op once done).
# Runs on every install, so the self-updater migrates after a fast-forward.
python3 "$ROOT/lib/migrate.py" || echo "warning: settings migration incomplete — run 'daimon migrate'" >&2

# A plist in ~/Library/LaunchAgents is a registration: launchd loads it at the
# next login whether or not anything loaded it now. So a plain install only
# refreshes daemons already registered; --load (scheduling is the point there)
# creates one for every active daemon.
if [ "$LOAD" -eq 1 ]; then
  PYTHONPATH="$ROOT" python3 -m daimon.sync --all
else
  PYTHONPATH="$ROOT" python3 -m daimon.sync
fi

if [ "$LOAD" -eq 1 ]; then
  load_fail=0
  for slug in $(python3 "$ROOT/lib/config.py" daemons) watchdog; do
    plist="$HOME/Library/LaunchAgents/com.${DAIMON_NS}.${slug}.plist"
    if [ ! -f "$plist" ]; then
      echo "missing plist for $slug: $plist" >&2
      load_fail=1
      continue
    fi
    launchctl bootout "gui/$(id -u)" "$plist" >/dev/null 2>&1 || true
    if launchctl bootstrap "gui/$(id -u)" "$plist" 2>/dev/null; then
      echo "loaded $slug"
    else
      echo "failed to load $slug from $plist" >&2
      load_fail=1
    fi
  done
  [ "$load_fail" -eq 0 ] || exit 1
else
  echo "plists generated (not loaded). Run 'daimon install --load' to schedule, or load individually."
fi
echo "done."
