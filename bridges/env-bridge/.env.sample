# See README Configuration
BRIDGE_NAME=env-bridge
BRIDGE_SLASH_COMMAND=/hub
# Channel IDs where @-mentions are questions for slack-ask (comma-separated)
# BRIDGE_ASK_CHANNELS=C0123456789
# Daily question limits for those channels: per person, and for everyone together
# BRIDGE_ASK_DAILY_LIMIT=30
# BRIDGE_ASK_DAILY_TEAM_LIMIT=100
# Issue-report channels (also listed above) where the bot gives every new
# report from the report form an automatic first look, and the form's app id
# BRIDGE_REPORT_CHANNELS=C0123456789
# BRIDGE_REPORT_APP_ID=A0123456789
# BRIDGE_REPORT_DAILY_LIMIT=20
# DAIMON_STATE_DIR=~/.local/state/daimon
# DAIMON_BIN=~/.local/bin/daimon
